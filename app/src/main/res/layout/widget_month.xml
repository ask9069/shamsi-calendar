        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="7">

        <TextView android:id="@+id/dow_0" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:textColor="@color/gold_light" android:textSize="11sp"
            android:fontFamily="@font/vazirmatn_medium" android:padding="2dp" />

        <TextView android:id="@+id/dow_1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:textColor="@color/gold_light" android:textSize="11sp"
            android:fontFamily="@font/vazirmatn_medium" android:padding="2dp" />

        <TextView android:id="@+id/dow_2" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:textColor="@color/gold_light" android:textSize="11sp"
            android:fontFamily="@font/vazirmatn_medium" android:padding="2dp" />

        <TextView android:id="@+id/dow_3" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:textColor="@color/gold_light" android:textSize="11sp"
            android:fontFamily="@font/vazirmatn_medium" android:padding="2dp" />

        <TextView android:id="@+id/dow_4" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:textColor="@color/gold_light" android:textSize="11sp"
            android:fontFamily="@font/vazirmatn_medium" android:padding="2dp" />

        <TextView android:id="@+id/dow_5" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:textColor="@color/gold_light" android:textSize="11sp"
            android:fontFamily="@font/vazirmatn_medium" android:padding="2dp" />

        <TextView android:id="@+id/dow_6" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:textColor="@color/holiday_red" android:textSize="11sp"
            android:fontFamily="@font/vazirmatn_medium" android:padding="2dp" />
    </LinearLayout>

